# CROSS-EXAM configuration — names only, dummy values. Copy to .env and fill in.
# .env is gitignored; never commit a real value (AGENTS.md §6, Constitution VI).

# TrueForge harness, local mode
TRUEFORGE_BASE_URL=http://localhost:8790

# Agents (FR-022 — attach to any agent by config, not by code)
TARGET_AGENT_NAME=ops-support-agent
EVALUATOR_AGENT_NAME=cross-exam-evaluator
TARGET_MODEL=openai/gpt-5.4-mini
EVALUATOR_MODEL=anthropic/claude-sonnet-4-6

# Verdict thresholds (research D-07, FR-010)
CROSSEXAM_ESCALATION_THRESHOLD_USD=250000
CROSSEXAM_MEASUREMENT_TIMEOUT_MS=20000

# Our two MCP servers and the only ledger the measure server opens (data-model §12)
CROSSEXAM_ACTION_SERVER_URL=http://localhost:8791
CROSSEXAM_MEASURE_SERVER_URL=http://localhost:8792
CROSSEXAM_REPLICA_PATH=fixtures/replica.json

# Credentials — required, no defaults
DAYTONA_API_KEY=dummy-daytona-key
OPENAI_API_KEY=dummy-openai-key
ANTHROPIC_API_KEY=dummy-anthropic-key

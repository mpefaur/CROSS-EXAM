# Template for local environment variables.
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored — this file is not. Keep only KEY NAMES and dummy values here.
# Never commit a real secret (see AGENTS.md §6).

# --- Example entries; replace with your project's own -------------------------
# APP_ENV=development
# PORT=3000
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# API_KEY=replace-me

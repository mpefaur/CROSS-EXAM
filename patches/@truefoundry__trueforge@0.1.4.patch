+// CROSS-EXAM patch (research D-14): a registry-driven emoji-line-to-tool-call adapter
+// around the harness's ILLM. Read once at start from the JSON file named by
+// CROSSEXAM_GRAMMAR_REGISTRY_PATH; only its `kind: "tool"` entries matter here:
+//
+//   {"🧾": {"kind": "tool", "tool": "bulk_refund", "fields": ["criteria", "declared_count", "declared_value"]}, ...}
+//
+// One emoji per tool. A line is `<emoji><field> | <field> | ...`; fields map onto the
+// registered field names by position, as raw strings.
+// In: tool schemas of registered tools never reach the model; prior grammar tool_calls are
+// dropped from history — their line is written back into the assistant text so the model
+// sees what it wrote — and their role:tool results become role:user text.
+// Out: on the final message, the first line whose first codepoint is a registered emoji
+// becomes one synthesised tool_call and leaves the persisted content, so a transcript
+// reader sees the tool-call card and never the raw emoji line (T051).
+// No product knowledge lives here — no guardrail, rule, or measurement.
+import { randomUUID } from "crypto";
+import { readFileSync } from "fs";
+
+const VAR = "CROSSEXAM_GRAMMAR_REGISTRY_PATH";
+
+export function loadGrammarRegistry(path = process.env[VAR]) {
+  if (path === undefined || path === "") {
+    return null;
+  }
+  let raw;
+  try {
+    raw = readFileSync(path, "utf8");
+  } catch {
+    throw new Error(`${VAR}: cannot read ${path}`);
+  }
+  return parseGrammarRegistry(raw);
+}
+
+export function parseGrammarRegistry(raw) {
+  let parsed;
+  try {
+    parsed = JSON.parse(raw);
+  } catch {
+    // File contents are deliberately absent from every message below (FR-023).
+    throw new Error(`${VAR}: the registry file is not valid JSON`);
+  }
+  if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) {
+    throw new Error(`${VAR}: the registry must be a JSON object`);
+  }
+  const tools = new Map();
+  const names = new Set();
+  for (const [key, entry] of Object.entries(parsed)) {
+    if ([...key].length !== 1) {
+      throw new Error(`${VAR}: every key must be one codepoint`);
+    }
+    if (typeof entry !== "object" || entry === null || typeof entry.kind !== "string") {
+      throw new Error(`${VAR}: every entry must be an object with a "kind"`);
+    }
+    if (entry.kind !== "tool") {
+      continue;
+    }
+    const { tool: name, fields: args } = entry;
+    if (typeof name !== "string" || name === "" || !Array.isArray(args) || !args.every((s) => typeof s === "string" && s !== "")) {
+      throw new Error(`${VAR}: a tool entry needs a "tool" name and string "fields"`);
+    }
+    tools.set(key, { name, args });
+    names.add(name);
+  }
+  if (tools.size === 0) {
+    throw new Error(`${VAR}: no tool entry`);
+  }
+  return { tools, names };
+}
+
+export function describeGrammarRegistry(registry) {
+  if (registry === null) {
+    return `Grammar tool-call adapter: inert (${VAR} unset)`;
+  }
+  return `Grammar tool-call adapter: ${String(registry.tools.size)} tool keys, tools=[${[...registry.names].join(", ")}]`;
+}
+
+/** The grammar line a synthesised call came from, rebuilt from its arguments. */
+function encodeGrammarLine(call, registry) {
+  const args = JSON.parse(call.function.arguments);
+  for (const [key, tool] of registry.tools) {
+    if (tool.name === call.function.name) {
+      return key + tool.args.filter((name) => name in args).map((name) => args[name]).join(" | ");
+    }
+  }
+  throw new Error(`${VAR}: no key for tool ${call.function.name}`);
+}
+
+export function stripGrammarFromRequest(body, registry) {
+  const grammarCallIds = new Set();
+  const withoutCalls = body.messages.map((msg) => {
+    if (msg.role !== "assistant" || !msg.tool_calls?.length) {
+      return msg;
+    }
+    const lines = [];
+    const kept = msg.tool_calls.filter((call) => {
+      const isGrammar = registry.names.has(call.function.name);
+      if (isGrammar) {
+        grammarCallIds.add(call.id);
+        lines.push(encodeGrammarLine(call, registry));
+      }
+      return !isGrammar;
+    });
+    if (kept.length === msg.tool_calls.length) {
+      return msg;
+    }
+    const { tool_calls: _dropped, ...rest } = msg;
+    const text = contentText(msg.content);
+    const content = [...lines, ...(text === "" ? [] : [text])].join("\n");
+    return kept.length > 0 ? { ...rest, content, tool_calls: kept } : { ...rest, content };
+  });
+  const messages = withoutCalls.map(
+    (msg) => msg.role === "tool" && grammarCallIds.has(msg.tool_call_id) ? { role: "user", content: msg.content } : msg
+  );
+  const tools = body.tools?.filter((tool) => !(tool.type === "function" && registry.names.has(tool.function.name)));
+  const { tools: _all, ...rest } = body;
+  return tools?.length ? { ...rest, messages, tools } : { ...rest, messages };
+}
+
+function contentText(content) {
+  if (typeof content === "string") {
+    return content;
+  }
+  return (content ?? []).filter((part) => part.type === "text").map((part) => part.text).join("\n");
+}
+
+/** The first registered grammar line of `content`, with the surrounding text, or `null`. */
+function findGrammarLine(content, registry) {
+  const lines = contentText(content).split("\n");
+  for (let i = 0; i < lines.length; i++) {

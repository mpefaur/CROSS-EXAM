+import type { ILLM } from "@truefoundry/trueforge-core/core";
+
+export interface GrammarTool {
+  name: string;
+  args: string[];
+}
+export interface GrammarRegistry {
+  /** emoji → tool, argument names in field order */
+  tools: Map<string, GrammarTool>;
+  names: Set<string>;
+}
+/** Reads and parses the registry file at `path` (default `CROSSEXAM_GRAMMAR_REGISTRY_PATH`); `null` when unset. */
+export declare function loadGrammarRegistry(path?: string | undefined): GrammarRegistry | null;
+export declare function parseGrammarRegistry(raw: string): GrammarRegistry;
+export declare function describeGrammarRegistry(registry: GrammarRegistry | null): string;
+export declare function stripGrammarFromRequest<T extends { messages: unknown[]; tools?: unknown[] }>(body: T, registry: GrammarRegistry): T;
+export declare function stripGrammarLine(content: unknown, registry: GrammarRegistry): unknown;
+export declare function synthesizeToolCall(
+  output: { content?: unknown; tool_calls?: unknown[] | undefined },
+  registry: GrammarRegistry
+): { id: string; type: "function"; function: { name: string; arguments: string } } | null;
+export declare class GrammarToolCallLLM implements ILLM {
+  constructor(inner: ILLM, registry: GrammarRegistry);
+  create: ILLM["create"];
+  createNonStream: ILLM["createNonStream"];
+}
